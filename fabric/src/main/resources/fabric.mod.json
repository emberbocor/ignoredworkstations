{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Mark a job site block with honeycomb so villagers ignore it; scrape it with an axe to undo. Only needed on the server.",
  "authors": [
    "Ember Bocor"
  ],
  "contact": {
    "homepage": "https://github.com/emberbocor/ignoredworkstations",
    "sources": "https://github.com/emberbocor/ignoredworkstations",
    "issues": "https://github.com/emberbocor/ignoredworkstations/issues"
  },
  "license": "${mod_license}",
  "environment": "*",
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": "${fabric_loader_version_range}",
    "minecraft": "${fabric_minecraft_version_range}",
    "java": ">=17"
  }
}
